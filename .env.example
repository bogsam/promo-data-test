APP_NAME=promo-data-test

# Sensitive values are not exposed in .env.example.
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=password

# HTTP port exposed by nginx
HTTP_PORT=8080

# PostgreSQL host port bound to loopback in docker-compose.yml
DB_PORT=5432

# Redis port bound to loopback on host
REDIS_PORT=6379